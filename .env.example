ANTHROPIC_API_KEY=
# MODEL=claude-opus-5-5
# EFFORT=high
# MAX_ROUNDS=2
# SEARCHES_PER_ROUND=10
# FETCHES_PER_ROUND=8

# goszakup.gov.kz open API token (РНУ). Empty -> source skipped.
GOSZAKUP_TOKEN=

# Identity score below which a finding goes to "possible namesakes".
# MATCH_THRESHOLD=0.5

# Wayback Machine fallback for removed / edited pages (archive.org may be unreachable from KZ networks).
# ARCHIVE_ENABLED=true
# Entity graph: hops from the subject and pivots explored per round.
# MAX_DEPTH=2
# PIVOTS_PER_ROUND=5
# Weight of a fact about a director / founder / subsidiary vs. the subject itself.
# AFFILIATE_WEIGHT=0.5

# SQLite store: audit trail, match features with reviewer labels, API jobs.
# DB_PATH=data/dd.sqlite
# Background screenings running at once (POST /jobs).
# JOB_WORKERS=2
# Cost accounting prices, USD (check current pricing).
# PRICE_INPUT_PER_MTOK=4.0
# PRICE_OUTPUT_PER_MTOK=20.0
# PRICE_WEB_SEARCH_PER_1K=10.0
